# Discord bot token (https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token-here

# Voice channel ID to rename with the current match (right-click channel -> Copy Channel ID)
VOICE_CHANNEL_ID=123456789012345678

# How often to check for a new current match, in seconds (default 60)
POLL_INTERVAL_SECONDS=60

# Where to load match data from. Default: openfootball worldcup.json (free, public domain).
# Override with a local file path for offline use, e.g. ./worldcup.json
MATCHES_URL=https://raw.githubusercontent.com/openfootball/worldcup.json/master/2026/worldcup.json

# How long after kickoff a match is considered "live" in minutes (default 130 — covers
# halftime + stoppage + a buffer; 90 + 15 break + 25 extra time/stoppage = 130).
LIVE_WINDOW_MINUTES=130

# Extra minutes added to the live window for elimination rounds (Round of 32 onward)
# to cover extra time + penalties. Default 60.
EXTRA_TIME_MINUTES=60

# Optional: when no match is live, what to show in the channel name. Use "" to leave the
# channel name unchanged between matches.
IDLE_NAME=
